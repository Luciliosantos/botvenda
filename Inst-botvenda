#!/bin/bash

set -e

REPO="https://raw.githubusercontent.com/Luciliosantos/botvenda/main"
BOT_DIR="/root/BOT"
BOT="$BOT_DIR/botvenda"
SHELLBOT="$BOT_DIR/ShellBot.sh"

clear
echo "======================================"
echo "     INSTALADOR BOTVENDA TECH NET"
echo "======================================"
echo

if [[ $EUID -ne 0 ]]; then
    echo "ERRO: execute como root."
    exit 1
fi

if [[ ! -d /etc/SSHPlus ]]; then
    echo "ERRO: este VPS não possui o painel SSHPlus."
    echo "Instale o painel SSHPlus primeiro."
    exit 1
fi

echo "[1/5] Verificando dependências..."
apt-get update -qq
apt-get install -y -qq wget curl screen at >/dev/null

mkdir -p "$BOT_DIR"

echo "[2/5] Localizando ShellBot..."

if [[ ! -f "$SHELLBOT" ]]; then
    for f in \
        /root/MEGA-clone/Sistema/ShellBot.sh \
        /root/MEGA-clone/Modulos/ShellBot.sh \
        /usr/local/bin/ShellBot.sh \
        /usr/bin/ShellBot.sh
    do
        if [[ -f "$f" ]]; then
            cp "$f" "$SHELLBOT"
            break
        fi
    done
fi

if [[ ! -f "$SHELLBOT" ]]; then
    echo "ERRO: ShellBot.sh não encontrado."
    echo "O painel SSHPlus instalado não possui o ShellBot esperado."
    exit 1
fi

echo
echo "======================================"
echo "        🔐 VALIDAÇÃO DA LICENÇA"
echo "======================================"

LICENCA_API="http://191.252.218.217:8787"
PRODUTO="BOTVENDA"

read -r -p "INFORME A LICENÇA DO BOT VENDA: " LICENCA

if [[ -z "$LICENCA" ]]; then
    echo "ERRO: licença não informada."
    exit 1
fi

VPS_ID="$(cat /etc/machine-id 2>/dev/null || hostname)"

echo "Validando licença..."

RESPOSTA="$(curl -fsS --max-time 15     -X POST "$LICENCA_API/api/licenca/validar"     -H "Content-Type: application/json"     --data "{\"codigo\":\"$LICENCA\",\"produto\":\"$PRODUTO\",\"vps_id\":\"$VPS_ID\"}" 2>/dev/null)" || {
    echo "ERRO: não foi possível conectar ao servidor de licenças."
    echo "API: $LICENCA_API"
    exit 1
}

if ! echo "$RESPOSTA" | grep -q '"ok":true'; then
    echo
    echo "❌ LICENÇA NÃO AUTORIZADA"
    echo "Resposta: $RESPOSTA"
    exit 1
fi

echo
echo "✅ LICENÇA VALIDADA COM SUCESSO"
echo "$RESPOSTA"
echo

echo "[3/5] Baixando BotVenda..."
wget -qO "$BOT" "$REPO/botvenda.sh"
wget -qO "$BOT_DIR/gerar_pix.sh" "$REPO/gerar_pix.sh"
wget -qO "$BOT_DIR/acompanhar_pagamento.sh" "$REPO/acompanhar_pagamento.sh"

chmod 700 "$BOT_DIR/gerar_pix.sh"
chmod 700 "$BOT_DIR/acompanhar_pagamento.sh"

if [[ ! -s "$BOT" ]]; then
    echo "ERRO: não foi possível baixar o botvenda."
    exit 1
fi

chmod 700 "$BOT"
chmod 644 "$SHELLBOT"

echo "[4/5] Verificando arquivos de pagamento..."
if [[ ! -s "$BOT_DIR/gerar_pix.sh" ]]; then
    echo "ERRO: gerar_pix.sh não foi baixado."
    exit 1
fi

if [[ ! -s "$BOT_DIR/acompanhar_pagamento.sh" ]]; then
    echo "ERRO: acompanhar_pagamento.sh não foi baixado."
    exit 1
fi

if screen -list | grep -q 'bot_venda'; then
    screen -S bot_venda -X quit
fi

echo
echo "[5/5] Configuração"
echo
read -r -p "INFORME O TOKEN DO BOT: " TOKEN

if [[ -z "$TOKEN" ]]; then
    echo "ERRO: token vazio."
    exit 1
fi

echo
echo "💳 CONFIGURAÇÃO MERCADO PAGO"
read -r -p "INFORME O ACCESS TOKEN DO MERCADO PAGO: " MP_TOKEN

if [[ -z "$MP_TOKEN" ]]; then
    echo "ERRO: Access Token do Mercado Pago vazio."
    exit 1
fi

echo "$MP_TOKEN" > "$BOT_DIR/mercadopago.token"
chmod 600 "$BOT_DIR/mercadopago.token"

cd "$BOT_DIR"
screen -dmS bot_venda "$BOT" "$TOKEN"

sleep 2

if screen -list | grep -q 'bot_venda'; then
    echo
    echo "======================================"
    echo "       BOTVENDA ATIVADO"
    echo "======================================"
    echo
    echo "Sessão: bot_venda"
    echo "Bot: $BOT"
else
    echo
    echo "ERRO: o BotVenda não permaneceu ativo."
    echo "Use:"
    echo "screen -S bot_venda -X hardcopy /tmp/botvenda.log"
    exit 1
fi
